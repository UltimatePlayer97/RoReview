{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,
    "noEmit": true,

    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "chrome"
    ],

    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },

  "include": [
    "src/**/*.ts",
    "vite.config.ts"
  ]
}
